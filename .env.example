# Copied to .env by `just setup`. Local-only demo credentials.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# Airflow connections
AIRFLOW_CONN_MINIO='{"conn_type": "aws", "login": "minio", "password": "minio123", "extra": {"endpoint_url": "http://minio:9000", "region_name": "us-east-1"}}'
AIRFLOW_CONN_WAREHOUSE_POSTGRES='postgresql://lakehouse:lakehouse@warehouse-postgres:5432/warehouse'

# Iceberg catalog (pyiceberg SQL catalog in Postgres + data in MinIO), as seen from containers
PYICEBERG_CATALOG__LAKEHOUSE__TYPE=sql
PYICEBERG_CATALOG__LAKEHOUSE__URI=postgresql+psycopg2://lakehouse:lakehouse@warehouse-postgres:5432/iceberg_catalog
PYICEBERG_CATALOG__LAKEHOUSE__WAREHOUSE=s3://warehouse
PYICEBERG_CATALOG__LAKEHOUSE__S3__ENDPOINT=http://minio:9000
PYICEBERG_CATALOG__LAKEHOUSE__S3__ACCESS_KEY_ID=minio
PYICEBERG_CATALOG__LAKEHOUSE__S3__SECRET_ACCESS_KEY=minio123
PYICEBERG_CATALOG__LAKEHOUSE__S3__REGION=us-east-1

# dbt (include/dbt/shop/profiles.yml)
DUCKDB_PATH=/usr/local/airflow/include/data/warehouse.duckdb
WAREHOUSE_PG_HOST=warehouse-postgres
WAREHOUSE_PG_PORT=5432
WAREHOUSE_PG_USER=lakehouse
WAREHOUSE_PG_PASSWORD=lakehouse
WAREHOUSE_PG_DB=warehouse

# Superset
SUPERSET_SECRET_KEY=change-me-lewagon-demo-only
